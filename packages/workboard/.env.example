# Copy to .env (git-ignored) and fill in. Everything here can also come from the
# process environment or from ~/.dsh/workboard.json — see README.md.

# Jira Cloud API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Sent as HTTP Basic together with JIRA_EMAIL.
JIRA_API_KEY=
JIRA_EMAIL=
JIRA_SITE=https://your-org.atlassian.net

# Google OAuth client used for the calendar consent flow.
# Register http://127.0.0.1:3080/workboard/calendar/callback as an authorized
# redirect URI on that client before connecting.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
TIME_ZONE=UTC
